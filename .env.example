# ==============================================================================
# CLIPAN PORTAL BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="Clipan Portal Backend"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://soc.clipan.co.id
BASE_PATH=""

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL)
# Default connects to the existing 'soc_dashboard' database with portal_* tables
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soc_dashboard
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# SECURITY & CORS
# ------------------------------------------------------------------------------
APP_KEY=clipan_portal_sec_key_2026_super_auth
CORS_ALLOWED_ORIGINS="*"
